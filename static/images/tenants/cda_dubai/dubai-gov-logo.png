<!-- EqualWeb Accessibility -->
<link rel="dns-prefetch" href="//cdn.equalweb.com">
<link rel="preconnect" href="https://cdn.equalweb.com" crossorigin>
<link rel="dns-prefetch" href="//access.equalweb.com">
<link rel="preconnect" href="https://access.equalweb.com" crossorigin>

<script data-cfasync="false">
(function () {
  function initEqualWeb() {
    var position = 'Right', lang = 'EN';

    // Detect RTL safely (no hard dependency on jQuery)
    try {
      if (document.body && document.body.classList.contains('rtl')) {
        lang = 'AR';
        position = 'Left';
      }
    } catch (e) {}

    window.interdeal = {
      sitekey: '393257ec6430c9dedd8e6bf074ee6792', // change per domain if needed
      Position: position,
      Menulang: lang,
      domains: { js: 'https://cdn.equalweb.com/', acc: 'https://access.equalweb.com/' },
      btnStyle: {
        vPosition: ['80%', null],
        scale: ['0.8', null],
        color: { main: '#3B3F54' },
        icon: { type: 7, shape: 'semicircle' }
      }
    };

    var s = document.createElement('script');
    s.src = window.interdeal.domains.js + 'core/4.6.3/accessibility.js';
    s.defer = true;
    s.crossOrigin = 'anonymous';
    s.setAttribute('data-cfasync', 'false'); // keep consistent
    s.onerror = function () {
      // If CDN is blocked/slow, at least you can detect it in console
      console.warn('EqualWeb failed to load (blocked or network issue).');
    };

    (document.body || document.head).appendChild(s);
  }

  // Ensure DOM is ready so document.body exists
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEqualWeb);
  } else {
    initEqualWeb();
  }

  // Make the custom button robust even if widget loads slowly
  function openEqualWebMenu() {
    var tries = 0;
    var timer = setInterval(function () {
      var btn = document.getElementById('INDmenu-btn');
      if (btn) {
        clearInterval(timer);
        btn.click();
      } else if (++tries > 30) { // ~3 seconds
        clearInterval(timer);
        console.warn('EqualWeb menu button not found yet.');
      }
    }, 100);
  }

  document.addEventListener('click', function (e) {
    if (e.target.closest('.accessibility-btn')) {
      openEqualWebMenu();
    }
  });
})();
</script>


