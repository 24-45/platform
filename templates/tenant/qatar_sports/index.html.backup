                                    </div>
                                </div>

                                <span class="slide__number">13</span>
                                <div class="slide__platform-logo">
                                    <span>24°45°</span> Platform
                                </div>
                            </section>

                            {% block extra_js %}
                            <script>
                            // بيانات خط الاتجاه (الأخبار التحريرية)
                            const coverageData = {
                                labels: ['22 أكتوبر', '29 أكتوبر', '5 نوفمبر', '12 نوفمبر', '19 نوفمبر', '26 نوفمبر', '3 ديسمبر', '10 ديسمبر', '17 ديسمبر', '24 ديسمبر', '31 ديسمبر', '7 يناير', '14 يناير'],
                                values: [73, 169, 76, 203, 183, 372, 487, 356, 372, 155, 151, 43, 38],
                                colors: ['#2e86de']
                            };

                            document.addEventListener('DOMContentLoaded', function() {
                                initCoverageChart();
                                initMatrixCells();
                            });

                            function initCoverageChart() {
                                const ctx = document.getElementById('coverageChart');
                                if (!ctx) return;

                                new Chart(ctx, {
                                    type: 'line',
                                    data: {
                                        labels: coverageData.labels,
                                        datasets: [{
                                            data: coverageData.values,
                                            label: 'عدد الأخبار',
                                            borderColor: coverageData.colors[0],
                                            backgroundColor: 'rgba(46, 134, 222, 0.15)',
                                            borderWidth: 2,
                                            fill: true,
                                            tension: 0.35,
                                            pointRadius: 4,
                                            pointBackgroundColor: '#D4AF37',
                                            pointBorderColor: '#fff',
                                            pointBorderWidth: 1,
                                            pointHoverRadius: 6
                                        }]
                                    },
                                    options: {
                                        responsive: true,
                                        maintainAspectRatio: false,
                                        plugins: {
                                            tooltip: {
                                                backgroundColor: 'rgba(0,0,0,0.8)',
                                                titleFont: { family: 'Tajawal', size: 12 },
                                                bodyFont: { family: 'Tajawal', size: 11 },
                                                rtl: true,
                                                textDirection: 'rtl',
                                                callbacks: {
                                                    label: function(context) {
                                                        return `${context.label}: ${context.raw.toLocaleString()} خبر`;
                                                    }
                                                }
                                            },
                                            legend: { display: false }
                                        },
                                        scales: {
                                            x: {
                                                grid: { color: 'rgba(255,255,255,0.05)', drawBorder: false },
                                                ticks: { color: 'rgba(255,255,255,0.7)', font: { family: 'Tajawal', size: 10 } }
                                            },
                                            y: {
                                                grid: { color: 'rgba(255,255,255,0.05)', drawBorder: false },
                                                ticks: {
                                                    color: 'rgba(255,255,255,0.7)',
                                                    font: { family: 'Tajawal', size: 10 },
                                                    callback: function(value) {
                                                        return value >= 1000 ? (value/1000).toFixed(1) + 'K' : value;
                                                    }
                                                },
                                                beginAtZero: true
                                            }
                                        }
                                    }
                                });
                            }

                            // بيانات مصفوفة تحليل المضمون
                            const matrixData = {
                                focus: {
                                    title: 'تركيز',
                                    color: '#6ab04c',
                                    icon: 'fas fa-crosshairs',
                                    description: 'رسائل ذات أهمية عالية لكن زخمها الإعلامي منخفض. تحتاج إلى تكثيف الجهود لزيادة انتشارها وتكرارها.',
                                    details: [
                                        'رسائل استراتيجية مهمة',
                                        'تحتاج دعم إعلامي أكبر',
                                        'فرصة لزيادة التأثير',
                                        'أولوية في الخطة الإعلامية'
                                    ]
                                },
                                enhance: {
                                    title: 'تعزيز',
                                    color: '#22a6b3',
                                    icon: 'fas fa-rocket',
                                    description: 'رسائل ذات أهمية عالية وزخم إعلامي مرتفع. هذه نقاط القوة التي يجب الحفاظ عليها وتعزيزها.',
                                    details: [
                                        'نقاط القوة الإعلامية',
                                        'تغطية ناجحة ومؤثرة',
                                        'يجب الحفاظ على الزخم',
                                        'نموذج للنجاح الإعلامي'
                                    ]
                                },
                                leverage: {
                                    title: 'استثمار',
                                    color: '#f1c40f',
                                    icon: 'fas fa-bullseye',
                                    description: 'رسائل ذات أهمية منخفضة لكن زخمها الإعلامي مرتفع. يمكن تحويل زخمها لخدمة الرسائل الأهم.',
                                    details: [
                                        'زخم مرتفع',
                                        'أهمية منخفضة',
                                        'فرصة لإعادة التوجيه',
                                        'تخدم رسائل أخرى'
                                    ]
                                },
                                correct: {
                                    title: 'تصحيح',
                                    color: '#eb8c47',
                                    icon: 'fas fa-exclamation-triangle',
                                    description: 'رسائل ذات أهمية منخفضة لكن زخمها مرتفع. تستهلك موارد إعلامية دون عائد مناسب، تحتاج إعادة توجيه.',
                                    details: [
                                        'إهدار للموارد الإعلامية',
                                        'تحتاج إعادة توجيه',
                                        'تقليل التركيز عليها',
                                        'نقل الجهد لأولويات أعلى'
                                    ]
                                }
                            };

                            function initMatrixCells() {
                                const cells = document.querySelectorAll('.matrix-cell');
                                const explanation = document.getElementById('matrix-explanation');
                                if (!cells.length || !explanation) return;

                                cells.forEach(cell => {
                                    cell.addEventListener('click', function() {
                                        const cellType = this.getAttribute('data-cell');
                                        const data = matrixData[cellType];
                                        cells.forEach(c => c.classList.remove('active'));
                                        this.classList.add('active');
                                        document.getElementById('explanation-title').textContent = data.title;
                                        document.getElementById('explanation-text').textContent = data.description;
                                        const iconEl = document.getElementById('explanation-icon');
                                        iconEl.innerHTML = `<i class="${data.icon}"></i>`;
                                        iconEl.style.background = data.color;
                                        const detailsEl = document.getElementById('explanation-details');
                                        detailsEl.innerHTML = `<ul>${data.details.map(d => `<li>${d}</li>`).join('')}</ul>`;
                                        explanation.classList.add('active');
                                    });
                                });
                            }

                            function closeExplanation() {
                                const explanation = document.getElementById('matrix-explanation');
                                const cells = document.querySelectorAll('.matrix-cell');
                                if (explanation) explanation.classList.remove('active');
                                cells.forEach(c => c.classList.remove('active'));
                            }
                            </script>
                            {% endblock extra_js %}
            <div class="matrix-container">
                <!-- المحور الرأسي -->
                <div class="matrix-axis matrix-axis--y">
                    <span>أهمية الرسائل</span>
                    <div class="axis-arrow axis-arrow--up"><i class="fas fa-arrow-up"></i></div>
                </div>
                
                <!-- المصفوفة الرئيسية -->
                <div class="content-matrix">
                    <div class="matrix-cell matrix-cell--focus" data-cell="focus">
                        <span class="cell-label">تركيز</span>
                    </div>
                    <div class="matrix-cell matrix-cell--enhance" data-cell="enhance">
                        <span class="cell-label">تعزيز</span>
                    </div>
                    <div class="matrix-cell matrix-cell--improve" data-cell="improve">
                        <span class="cell-label">تحسين</span>
                    </div>
                    <div class="matrix-cell matrix-cell--correct" data-cell="correct">
                        <span class="cell-label">تصحيح</span>
                    </div>
                    <div class="matrix-center">
                        <span>المضمون</span>
                        <span>الإعلامي</span>
                    </div>
                </div>
                
                <!-- المحور الأفقي -->
                <div class="matrix-axis matrix-axis--x">
                    <span>الزخم الإعلامي (التكرار)</span>
                    <div class="axis-arrow axis-arrow--right"><i class="fas fa-arrow-right"></i></div>
                </div>
            </div>
            
            <!-- تفسير المصفوفة -->
            <div class="matrix-interpretation">
                <div class="interp-item interp-focus">
                    <span class="interp-label">تركيز</span>
                    <p>أهمية عالية + زخم منخفض = زيادة التغطية</p>
                </div>
                <div class="interp-item interp-enhance">
                    <span class="interp-label">تعزيز</span>
                    <p>أهمية عالية + زخم عالي = الحفاظ والتطوير</p>
                </div>
                <div class="interp-item interp-improve">
                    <span class="interp-label">تحسين</span>
                    <p>أهمية منخفضة + زخم منخفض = إعادة تقييم</p>
                </div>
                <div class="interp-item interp-correct">
                    <span class="interp-label">تصحيح</span>
                    <p>أهمية منخفضة + زخم عالي = إعادة توجيه</p>
                </div>
            </div>
        </div>
        
