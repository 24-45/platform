{% extends "tenant/qatar_sports/base.html" %}

{% block content %}
<!-- =====================================================
     الشريحة 1: الغلاف الرئيسي
     تقرير الرصد والتحليل الإعلامي للرياضة القطرية
     ===================================================== -->
<section class="slide slide--cover" id="slide-1">
    <!-- الزخارف الخلفية -->
    <div class="cover-bg">
        <div class="cover-gradient"></div>
        <div class="cover-pattern"></div>
    </div>
    
    <div class="slide__content slide__content--center">
        <!-- شعار الوزارة الرسمي -->
        <div class="ministry-logo-container">
            <img src="{{ url_for('static', filename='images/tenants/qatar_sports/ministry_logo.svg') }}" 
                 alt="وزارة الرياضة والشباب - دولة قطر" 
                 class="ministry-logo">
        </div>
        
        <!-- الخط الفاصل -->
        <div class="cover-divider"></div>
        
        <!-- العنوان الرئيسي -->
        <h1 class="cover-title">
            تقرير الرصد والتحليل الإعلامي
        </h1>
        
        <!-- العنوان الفرعي -->
        <h2 class="cover-subtitle">
            دراسة تحليلية منهجية للمشهد الإعلامي
            <br>
            <span class="highlight">للرياضة القطرية محلياً ودولياً</span>
        </h2>
        
        <!-- معلومات الفترة -->
        <div class="cover-period">
            <div class="period-icon">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="period-info">
                <span class="period-label">فترة الرصد</span>
                <span class="period-dates">أكتوبر 2025 - يناير 2026</span>
                <span class="period-duration">90 يوماً</span>
            </div>
        </div>
    </div>
</section>

<!-- =====================================================
     الشريحة 2: نظرة عامة على التقرير
     ===================================================== -->
<section class="slide slide--overview" id="slide-2">
    <!-- Slide 2 content will go here -->
</section>

<!-- Placeholder for remaining slides -->

<!-- =====================================================
     الشريحة 10: Placeholder
     ===================================================== -->

