                                                <div class="peak-event">
                                                    <div class="peak-date">
                                                        <span class="peak-day">18</span>
                                                        <span class="peak-month">ديسمبر</span>
                                                    </div>
                                                    <div class="peak-info">
                                                        <span class="peak-count">3,827</span>
                                                        <span class="peak-label">منشور</span>
                                                    </div>
                                                    <div class="peak-reason">
                                                        <i class="fas fa-flag-checkered"></i>
